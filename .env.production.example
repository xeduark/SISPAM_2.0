# ---------------------------------------------------------------------------
# SISPAM 2 — producción (https://consultasavia.comitedeestudiosmedicos.com.co)
#
# Copia este archivo como .env en el servidor y llena lo que está vacío.
# AQUÍ NO VA NINGÚN SECRETO: las claves se escriben solo en el .env del
# servidor (chmod 600) y en el gestor de contraseñas. Ver docs/despliegue.md.
#
# Primera salida: solo las cuentas de consulta de las sedes y el administrador.
# ---------------------------------------------------------------------------

APP_NAME="SISPAM 2"
APP_ENV=production
# Se genera en el servidor: php artisan key:generate --force
# Guárdala también fuera del servidor: sin ella no se leen los datos cifrados.
APP_KEY=
APP_DEBUG=false
APP_URL=https://consultasavia.comitedeestudiosmedicos.com.co

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=America/Bogota
APP_FAKER_LOCALE=es_CO

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Un archivo por día, 30 días. Solo advertencias y errores.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sispam
DB_USERNAME=sispam
DB_PASSWORD=

# La sesión guarda el nombre y el documento de quien usa una cuenta
# compartida: va cifrada. La cookie solo viaja por https.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Tiene que admitir candados (el del token de Savia): database sí.
CACHE_STORE=database

MAIL_MAILER=log

# Módulos encendidos en esta instalación (lista blanca, claves de Rol::MODULOS).
# Lo que no esté aquí no existe, ni para el administrador.
SISPAM_MODULOS=consultar_paciente,usuarios,sedes,auditoria

# Si delante del servidor hay un proxy (Cloudflare, un balanceador): sus IP
# separadas por coma, o * si no son fijas. Sin proxy, vacío.
TRUSTED_PROXIES=

AUTHENTIK_BASE_URL=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI="${APP_URL}/auth/authentik/callback"
AUTHENTIK_APP_SLUG=

# Opcional: comentada son 30 minutos.
#CUENTA_COMPARTIDA_MINUTOS_SIN_USO=30

# Módulos apagados: sin claves.
GOOGLE_VISION_API_KEY=
TRANSCRIPCION_MOTOR=vision
GEMINI_API_KEY=
INVENTARIO_API_URL=
INVENTARIO_API_TOKEN=

# Consulta Afiliados — Savia Salud EPS (PRODUCCIÓN)
SAVIA_USERNAME=
SAVIA_PASSWORD=
SAVIA_VERIFY_SSL=true
# La tabla `auditorias` ya registra cada consulta (quién, qué documento, si
# hubo resultado). Apagado, los números de documento no quedan además en el
# log. Las fallas de Savia sí quedan, como advertencia.
SAVIA_AUDITAR=false
SAVIA_TIMEOUT=10
SAVIA_CONNECT_TIMEOUT=5

# OBLIGATORIAS cuando Savia entregue las direcciones de producción.
# Mientras estén comentadas, SISPAM usa las del AMBIENTE DE PRUEBAS.
# No las dejes vacías: vacías no toman el valor por defecto.
#SAVIA_ENDPOINT=
#SAVIA_ENDPOINT_TOKEN=
